# Conexión a Postgres (en Railway: referencia a la base de datos del mismo proyecto)
# En local usa la URL PÚBLICA que te da Railway (DATABASE_PUBLIC_URL)
DATABASE_URL=postgresql://usuario:clave@host:puerto/railway

# PIN para entrar a la agenda (cámbialo)
PROFESOR_PIN=1234

# Opcional
TZ_NEGOCIO=America/El_Salvador
